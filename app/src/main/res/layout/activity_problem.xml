<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primary_dark">
<LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" app:layout_constraintTop_toTopOf="parent">
<ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_arrow_back" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回" app:tint="@color/accent" />
<TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
<ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_settings" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="设置" app:tint="@color/accent" />
</LinearLayout>
<FrameLayout android:id="@+id/boardContainer" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/bottomPanel" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:padding="8dp">
<com.wangyu.gotsumego.ui.GoBoardView android:id="@+id/boardView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" />
<TextView android:id="@+id/tvTrialMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp" android:text="试下模式" android:textColor="@color/white" android:textSize="14sp" android:background="#CCFF9800" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone" />
</FrameLayout>
<LinearLayout android:id="@+id/bottomPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/primary_dark" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp" app:layout_constraintBottom_toBottomOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
<TextView android:id="@+id/tvToPlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold" android:paddingEnd="12dp" />
<TextView android:id="@+id/tvProblemNumber" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#AAA" android:textSize="14sp" />
<TextView android:id="@+id/tvFeedback" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="6dp">
<com.google.android.material.button.MaterialButton android:id="@+id/btnShowAnswer" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="显示答案" android:textColor="@color/white" android:textSize="16sp" android:layout_marginEnd="6dp" app:backgroundTint="@color/accent" app:cornerRadius="12dp" app:icon="@drawable/ic_hint" app:iconGravity="textStart" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="重置" android:textColor="@color/accent" android:textSize="16sp" app:backgroundTint="@android:color/transparent" app:cornerRadius="12dp" app:strokeColor="@color/accent" app:strokeWidth="1dp" app:icon="@drawable/ic_refresh" app:iconGravity="textStart" app:iconTint="@color/accent" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/btnPrev" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="上一题" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginEnd="4dp" app:backgroundTint="#2A2A3E" app:cornerRadius="10dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnNext" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="下一题" android:textColor="@color/accent" android:textSize="14sp" android:layout_marginStart="4dp" app:backgroundTint="#2A2A3E" app:cornerRadius="10dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnExitTrial" android:layout_width="wrap_content" android:layout_height="44dp" android:text="退出试下" android:textColor="#FF9800" android:textSize="14sp" android:visibility="gone" app:backgroundTint="#3E2A2A" app:cornerRadius="10dp" />
</LinearLayout>
</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>